<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">
  <data>
      <variable
          name="model"
          type="com.userplay.bazar22.ui.fragments.home.models.PairsModelDigits" />
  </data>
    <androidx.cardview.widget.CardView
        android:id="@+id/cardItem"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_margin="5dp"
        app:cardCornerRadius="@dimen/_10sdp"
        app:cardElevation="5dp"
        app:cardBackgroundColor="@color/white">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_border">
            <TextView
                android:id="@+id/tvPair"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@color/red"
                android:textColor="@color/white"
                tools:text="100"
                android:text="@{model.pairNumber}"
                android:gravity="center"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintWidth_percent=".3"
                />
            <androidx.appcompat.widget.AppCompatEditText
                android:id="@+id/edValue"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toEndOf="@+id/tvPair"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@color/trans"
                android:inputType="number"
                android:text="@={model.pairPoint}"
                android:textSize="@dimen/_12ssp"
                android:paddingStart="@dimen/_3sdp"
                android:textColor="@color/black"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>
</layout>