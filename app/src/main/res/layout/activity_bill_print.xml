<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bill_screen_bg">

    <!-- ── Toolbar ──────────────────────────────────────────────────────── -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bill_toolbar_bg"
        app:navigationIcon="@drawable/ic_round_arrow_back_ios_24"
        app:navigationIconTint="@color/bill_toolbar_text"
        app:title="Your Bids Placed Successfully"
        app:titleTextColor="@color/bill_toolbar_text" />

    <!-- ── Bill preview (scrollable) ────────────────────────────────────── -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="16dp"
        android:clipToPadding="false"
        android:fillViewport="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal">

            <!--
                CardView simulates thermal paper on screen.
                The bill content is injected programmatically inside
                billPreviewContainer by BillPrintActivity.
            -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="4dp"
                app:cardElevation="4dp"
                app:cardMaxElevation="6dp"
                app:cardBackgroundColor="@android:color/white">

                <LinearLayout
                    android:id="@+id/billPreviewContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:maxWidth="320dp" />

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </ScrollView>

    <!-- ── Bottom divider ───────────────────────────────────────────────── -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/bill_divider_color" />

    <!-- ── Action buttons ────────────────────────────────────────────────── -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/white"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center">

        <!-- Print — filled primary -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPrint"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="Print"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:letterSpacing="0.05"
            app:backgroundTint="@color/bill_btn_print"
            app:cornerRadius="10dp"
            app:icon="@drawable/ic_printer"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconPadding="8dp"
            app:iconTint="@android:color/white" />

        <!-- Share — outlined -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Share"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="@color/bill_btn_print"
            android:letterSpacing="0.05"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="10dp"
            app:strokeColor="@color/bill_btn_print"
            app:strokeWidth="1.5dp"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconSize="20dp"
            app:iconPadding="8dp"
            app:iconTint="@color/bill_btn_print" />

    </LinearLayout>

</LinearLayout>
