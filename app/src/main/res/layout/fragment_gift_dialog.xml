<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:lottie="http://schemas.android.com/tools"
    android:id="@+id/llGift"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/white_round"
    android:gravity="center"
    android:orientation="vertical">
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/_15sdp"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_marginTop="@dimen/_50sdp"
                android:src="@drawable/ic_gift_dialog"
                />

            <TextView
                android:id="@+id/tvHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Redeem Your Gift"
                android:layout_marginTop="@dimen/_10sdp"
                android:textColor="@color/black"
                android:textStyle="bold"
                android:textSize="20dp" />
            <TextView
                android:id="@+id/tvGiftDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_11sdp"
                android:text="you have received"
                android:visibility="gone"
                android:textAlignment="center"
                android:layout_marginTop="@dimen/_4sdp"
                android:textColor="@color/black"
                android:textSize="@dimen/_12ssp" />
            <LinearLayout
                android:id="@+id/llEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/yellow_round_border"
                android:orientation="horizontal">
                <EditText
                    android:id="@+id/edGiftCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Please enter your gift code"
                    android:textColorHint="@color/dark_grey"
                    android:textColor="@color/black"
                    android:inputType="text"
                    android:maxLength="30"
                    android:paddingHorizontal="@dimen/_8sdp"
                    android:paddingVertical="12dp"
                    android:background="@android:color/transparent"/>
            </LinearLayout>
            <ProgressBar
                android:id="@+id/mProgress"
                android:layout_marginTop="@dimen/_5sdp"
                android:layout_width="@dimen/_30sdp"
                android:layout_height="@dimen/_30sdp"
                android:visibility="gone"/>
            <TextView
                android:id="@+id/tvErrorGift"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_11sdp"
                android:text=""
                android:textColor="@color/red"
                android:textSize="@dimen/_12ssp"
                android:layout_marginVertical="@dimen/_2sdp" />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="@dimen/_5sdp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnSubmitGift"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:backgroundTint="@color/yellow"
                    android:text="Submit"
                    android:layout_marginHorizontal="16dp"
                    android:textColor="@color/text_color_over_buttons"
                    />
            </LinearLayout>
        </LinearLayout>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottieView"
            android:layout_width="match_parent"
            android:layout_height="@dimen/_150sdp"
            app:lottie_rawRes="@raw/confetti_popup"
            app:lottie_autoPlay="false"
            android:visibility="gone"
            app:lottie_loop="true" />
        <ImageView
            android:id="@+id/imgClose"
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:src="@drawable/ic_round_close_24"
            android:layout_alignParentEnd="true"
            android:tint="@color/red"/>

    </RelativeLayout>



</LinearLayout>